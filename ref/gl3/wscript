#! /usr/bin/env python
# encoding: utf-8

top = '.'

def options(opt):
	pass

def configure(conf):
	pass

def glsl_header(task):
	# shaders/<name>.glsl becomes "<name>.glsl.h" holding the source as the string <name>_glsl
	name = task.inputs[0].name[:-len('.glsl')]
	lines = task.inputs[0].read().splitlines()
	text = ''.join('"%s\\n"\n' % line.replace('\\', '\\\\').replace('"', '\\"') for line in lines)
	task.outputs[0].write('static const char %s_glsl[] =\n%s;\n' % (name, text))

def build(bld):
	for glsl in bld.path.ant_glob('shaders/*.glsl'):
		bld(rule = glsl_header, source = glsl, target = glsl.name + '.h', before = ['c'])

	bld.shlib(
		source = bld.path.ant_glob('*.c'),
		target = 'ref_gl3',
		includes = '. khronos ' + bld.path.get_bld().abspath(),
		features = 'c',
		defines = 'REF_DLL=1',
		use = 'ref_common engine_includes sdk_includes public M werror yy_thunks',
		install_path = bld.env.LIBDIR
	)
