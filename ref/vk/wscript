#! /usr/bin/env python
# encoding: utf-8

import os, re, subprocess

top = '.'

# Every program the core asks for that is drawn through Vulkan: its file, its defines, the flashlight's variant.
# The same files as ref_gl3's, with this prelude instead of GLSL 330's.
PROGRAMS = [
	( 'draw', '', False ),
	( 'draw', '#define WARP_SCREEN 1\n', False ),
	( 'draw', '#define WARP_WAVE 1\n', False ),
]

PRELUDE = '''#version 450
#define %s 1
#define VS_REGISTERS( n ) layout( std140, set = 0, binding = 0 ) uniform gl3_vs { vec4 vsc[n]; };
#define PS_REGISTERS( n ) layout( std140, set = 0, binding = 1 ) uniform gl3_ps { vec4 psc[n]; };
#define SAMPLER( name, unit ) layout( set = 1, binding = unit ) uniform sampler2D name;
#define ATTR( type, name, slot ) layout( location = slot ) in type name;
#define VK_FIX_CLIP() gl_Position.z = 0.5 * ( gl_Position.z + gl_Position.w )
'''

def options(opt):
	pass

def configure(conf):
	pass

def c_string(text):
	return '"' + text.replace('\\', '\\\\').replace('"', '\\"').replace('\n', '\\n') + '"'

def compile_stage(task, index, stage, define, text):
	out = task.outputs[0].parent.abspath()
	src = os.path.join(out, 'vk_shader_%d.%s' % (index, stage))
	spv = src + '.spv'

	with open(src, 'w') as f:
		f.write(PRELUDE % define + text)

	if subprocess.call(task.env.GLSLANG + ['-V', '--aml', '--quiet', '-S', stage, '-o', spv, src]) != 0:
		return None

	with open(spv, 'rb') as f:
		data = f.read()

	return [int.from_bytes(data[i:i + 4], 'little') for i in range(0, len(data), 4)]

def compile_shaders(task):
	files = dict((n.name, n.read()) for n in task.inputs)
	arrays = []
	entries = []

	for index, (name, defines, spot) in enumerate(PROGRAMS):
		source = files[name + '.glsl']
		text = defines + ('#define SPOT 1\n' + files['flashlight.glsl'] if spot else '') + source
		stages = []

		for stage, define in ( ('vert', 'VERTEX_SHADER'), ('frag', 'FRAGMENT_SHADER') ):
			words = compile_stage(task, index, stage, define, text)
			if words is None:
				return 1
			stages.append(words)
			arrays.append('static const uint32_t vk_spv_%d_%s[] = { %s };\n' % (index, stage, ','.join('0x%x' % w for w in words)))

		vs = max([int(x) for x in re.findall(r'VS_REGISTERS\(\s*(\d+)', source)] or [0])
		ps = max([int(x) for x in re.findall(r'PS_REGISTERS\(\s*(\d+)', source)] or [0])
		entries.append('\t{ %s, %s, %s, vk_spv_%d_vert, sizeof( vk_spv_%d_vert ), vk_spv_%d_frag, sizeof( vk_spv_%d_frag ), %d, %d },\n' %
			(c_string(name), c_string(defines), 'true' if spot else 'false', index, index, index, index, vs, ps))

	task.outputs[0].write('''typedef struct
{
	const char *name, *defines;
	qboolean spot;
	const uint32_t *vs;
	size_t vs_size;
	const uint32_t *fs;
	size_t fs_size;
	int vs_registers, ps_registers;
} vk_shader_source_t;

''' + ''.join(arrays) + '\nstatic const vk_shader_source_t vk_shader_sources[] =\n{\n' + ''.join(entries) + '};\n')
	return 0

def build(bld):
	# the renderer's core is ref_gl3's: r_device.c is what this backend replaces
	gl3 = bld.path.parent.find_dir('gl3')
	shaders = gl3.find_dir('shaders').ant_glob('*.glsl')

	bld(rule = compile_shaders, source = shaders, target = 'vk_shaders.h', before = ['c'])

	bld.shlib(
		source = gl3.ant_glob('r_*.c', excl = 'r_device.c') + bld.path.ant_glob('*.c'),
		target = 'ref_vk',
		includes = '. ../gl3 ' + gl3.get_bld().abspath() + ' ' + bld.path.get_bld().abspath(),
		features = 'c',
		defines = 'REF_DLL=1 GL3_RENDER_API=REF_VULKAN',
		use = 'ref_common engine_includes sdk_includes public M werror yy_thunks',
		install_path = bld.env.LIBDIR
	)
