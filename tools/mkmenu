#!/usr/bin/env python3
# The gamepad menu's own layer: page banners (gfx/shell/head_*) in the 1998 Half-Life style at the size a 720p
# screen draws them, the button atlas, the pad legend's icons, the Controller page's picture, and our menu string
# files, for English and every language we translate.
# Valve's banners are 460x80 bitmaps stretched to 690x120 on a 720p screen, which is why their letters look soft;
# these are rendered at that size. The glow recipe: draw the text 4x oversized, scale it down with Lanczos, blur
# it, then map the coverage through the fire ramp (dark red -> orange -> yellow -> white core), with the gain
# fitted so the same share of the letters burns white as in Valve's banners.
# The font is Trebuchet MS Bold (Microsoft, not redistributable), so it is read from outside the repository and
# only the rendered images are ever shipped.
# Strings we translate ourselves live in tools/menu/localization/mainui_<language>.txt (what the game data does
# not translate, keyed by the English text); they are installed into the run tree's valve/resource/, and their
# Banner_* entries name the headings, so a language gets its own banners under valve_<language>/gfx/shell/,
# which the engine reads over valve/.
# The legend's icons are the Xbox face buttons of AL2009man/Gamepad-Asset-Pack (MIT, (c) 2024 Al. Lopez): a
# build that ships them carries that licence. The controller is tools/menu/360_controller.svg (CC BY-SA 3.0).
# Usage: [MKMENU_FONT=...trebucbd.ttf] [MKMENU_PADS=<Gamepad-Prompt-Asset-Pack checkout>] [MKMENU_PAD_ICONS=<dir>]
#        mkmenu [run tree]
#        mkmenu --sheet out.png   writes a comparison sheet instead (ours under Valve's, upscaled the same way)
# Env: MKMENU_DATA is the game data (default ~/src/xbox-dev/assets/HalfLife-Steam); MKMENU_LOADING, if set,
# names a 1280x720 loading picture to install as gfx/shell/loading.tga. Needs Pillow and cairosvg
# (MKMENU_CAIROSVG, default ~/.venvs/svg/bin/cairosvg).
import io, os, re, sys, struct, subprocess
from PIL import Image, ImageDraw, ImageFont, ImageFilter

W, H, S = 690, 120, 4			# the banner rect at 720p, and the oversampling factor
X, BASE = 13, 92			# left margin and baseline, so the words sit where Valve's do in the rect
TRACK, BLUR, STROKE = 0.04, 5.5, 1	# letter spacing in em, glow radius, and the widening that gives
					# the letters Valve's weight
REF_TEXT, REF_WIDTH = 'Advanced controls', 634	# one size for every banner: the longest one as wide as Valve's
SPLIT = 0.8				# coverage at which the flame turns from red-orange to yellow-white
FIT_P, FIT_HEAT = 0.75, 0.875		# fit the gain so this percentile of the lit pixels reaches this heat

# The button atlas (gfx/shell/btns_main.bmp): one 156x26 cell per button id in the order of mainui's PC_
# enum, three states stacked - the flat gold label, the glow behind a focused one, and the focused label with
# the letters punched out of the glow, as Valve's WON atlas has them. Ids we do not name keep Valve's cell.
BTN_W, BTN_H = 156, 26
BTN_SIZE, BTN_X, BTN_BASE = 15, 4, 17	# fitted to Valve's "New game": same width and the same baseline
BTN_FLAT = (240, 180, 63)
