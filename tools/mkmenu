font_path = os.environ.get('MKMENU_FONT', os.path.expanduser('~/src/xbox-dev/assets/fonts/trebucbd.ttf'))

def coverage(text, size):
	big = Image.new('L', (W * S, H * S), 0)
	f = ImageFont.truetype(font_path, int(size * S))
	d = ImageDraw.Draw(big)
	x = X * S
	for ch in text:
		d.text((x, BASE * S), ch, font=f, fill=255, anchor='ls', stroke_width=STROKE * S, stroke_fill=255)
		x += f.getlength(ch) + TRACK * size * S
	return big.resize((W, H), Image.LANCZOS).filter(ImageFilter.GaussianBlur(BLUR))

def ramp(split=SPLIT):
	t = []
	for v in range(256):
		h = v / 255
		if h < split:
			r = h / split * 255
			t.append((int(r), int(0.55 * r), 0))
		else:
			t.append((255, int(140 + 115 * (h - split) / (1 - split)), 0))
	return t
RAMP = ramp()

def colorize(cov, gain):
	out = Image.new('RGB', cov.size)
	out.putdata([RAMP[min(255, int(v * gain))] for v in cov.getdata()])
	return out

def fit_size(text=REF_TEXT, want=REF_WIDTH):
	lo, hi = 10.0, 140.0
	for _ in range(25):
		size = (lo + hi) / 2
		b = coverage(text, size).point(lambda v: 255 if v > 40 else 0).getbbox()
		if b[2] - b[0] > want: hi = size
		else: lo = size
	return (lo + hi) / 2

def fit_gain(cov):
	lo, hi = 0.3, 6.0
	for _ in range(18):
		gain = (lo + hi) / 2
		lit = sorted(min(255, int(v * gain)) for v in cov.getdata() if v * gain > 40)
		if not lit or lit[int(FIT_P * (len(lit) - 1))] / 255 < FIT_HEAT: lo = gain
		else: hi = gain
	return (lo + hi) / 2

def banner(text, size):
	width = text_width(text, size, TRACK) + 2 * STROKE + 2 * BLUR	# the glow reaches past the letters
	if X + width > W - 8:				# a heading longer than the reference one is squeezed into the rect
		size *= (W - 8 - X) / width
	cov = coverage(text, size)
	return colorize(cov, fit_gain(cov))

def write_tga(im, path):			# uncompressed, bottom-up, as Valve's shell art is; 32-bit when it has alpha
	w, h = im.size
	alpha = im.mode == 'RGBA'
	order = (2, 1, 0, 3) if alpha else (2, 1, 0)
	rows = b''.join(bytes(bytearray([p[i] for p in im.crop((0, y, w, y + 1)).getdata() for i in order]))
			for y in range(h - 1, -1, -1))
	with open(path, 'wb') as f:
		f.write(struct.pack('<BBBHHBHHHHBB', 0, 0, 2, 0, 0, 0, 0, 0, w, h, 32 if alpha else 24, 8 if alpha else 0) + rows)

def btn_coverage(text, size):
	big = Image.new('L', (BTN_W * S, BTN_H * S), 0)
	f = ImageFont.truetype(font_path, int(size * S))
	d = ImageDraw.Draw(big)
	x, first = BTN_X * S, True
	for ch in text:
		d.text((x, BTN_BASE * S), ch, font=f, fill=255, anchor='ls')
		adv = f.getlength(ch)
		if first and ch != ' ':		# WON underlines the first letter, the keyboard shortcut
			d.rectangle([x, BTN_BASE * S + 2 * S, x + adv - 1, BTN_BASE * S + 3 * S], fill=255)
			first = False
		x += adv
	return big.resize((BTN_W, BTN_H), Image.LANCZOS)

def btn_fire(mask, blur, gain, split = 0.30, gmax = 226):
	lut = []
	for v in range(256):
		h = min(1.0, v * gain / 255)
		if h < split:
			r = int(h / split * 255)
			lut.append(( r, int(0.30 * r), 0 ))
		else:
			t = (h - split) / (1 - split)
			lut.append(( 255, int(60 + (gmax - 60) * t), int(30 * t) ))
	glow = mask.filter(ImageFilter.GaussianBlur(blur))
	out = Image.new('RGB', mask.size)
	out.putdata([lut[v] for v in glow.getdata()])
	return out

def text_width(text, size, track = 0.0):	# measured on the font: a picture crops what does not fit
	f = ImageFont.truetype(font_path, int(size * S))
	return (sum(f.getlength(ch) for ch in text) + track * size * S * (len(text) - 1)) / S

def button(text):
	size = BTN_SIZE
	width = text_width(text, size)
	if BTN_X + width > BTN_W - 4:			# a long label is squeezed into the cell
		size *= (BTN_W - 4 - BTN_X) / width
	cov = btn_coverage(text, size)
	letters = cov.point(lambda v: 255 if v > 120 else 0)
	flat = Image.merge('RGB', tuple(cov.point(lambda v, c = c: v * c // 255) for c in BTN_FLAT))
	focused = btn_fire(cov, 1.9, 3.4)
	focused.paste(( 0, 0, 0 ), ( 0, 0 ), letters)	# the glow shows around the letters, not through them
	return [ flat, btn_fire(cov, 1.6, 2.6), focused ]

def write_buttons(path, labels, valve_atlas):
	cells = valve_atlas.height // (BTN_H * 3)
	atlas = Image.new('RGB', (BTN_W, cells * BTN_H * 3))
	for i in range(cells):
		if i in labels:
			states = button(labels[i])
		else:					# an id we do not name keeps Valve's art
			states = [valve_atlas.crop(( 0, (i * 3 + s) * BTN_H, BTN_W, (i * 3 + s + 1) * BTN_H )) for s in range(3)]
		for s, im in enumerate(states):
			atlas.paste(im, ( 0, (i * 3 + s) * BTN_H ))
	out = atlas.convert('P', palette = Image.ADAPTIVE, colors = 255)	# 8-bit, as Valve ships it
	out = out.point(list(range(1, 256)) + [ 255 ])			# mainui fills the guard pixels between the
	out.putpalette([ 0, 0, 0 ] + out.getpalette()[:765])		# atlas cells with index 0, so that index has
	out.save(path)							# to be black: the buttons are drawn additively
	print(f'  {path.replace(run, "")}: {len(labels)} of {cells} buttons')

