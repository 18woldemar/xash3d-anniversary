DIAGRAM_W, DIAGRAM_H = 855, 310
PAD_W, PAD_H = 405, 257			# the controller, centred at the bottom
PAD_X, PAD_Y = (DIAGRAM_W - PAD_W) // 2, DIAGRAM_H - PAD_H - 4
LABEL_SIZE, LABEL_LINE, LABEL_GAP, LINE_GAP = 18, 21, 14, 8
WON_ORANGE = (240, 180, 24)
