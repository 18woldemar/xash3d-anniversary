	((0.880, 0.499), 'R', 158, 'Crouch (hold)'),					# B: +duck
	((0.717, 0.509), 'R', 194, 'Use'),						# X
	((0.798, 0.600), 'R', 222, 'Jump'),						# A
	((0.636, 0.787), 'R', 246, 'Look\nClick: flashlight'),				# right stick: impulse 100
	((0.393, 0.515), 'TL', 4, 'Flashlight'),					# BACK: impulse 100
