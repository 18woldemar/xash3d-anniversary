PAD_PALETTE = {
	'#ffffff': '#262626', '#f2f2f2': '#2f2f2f', '#bfbfbf': '#3a3a3a',	# body, stick rings, top ridge
	'#515151': '#1c1c1c', '#4a4a4a': '#181818', '#424242': '#141414',	# sticks and d-pad
	'#898989': '#4a4a4a', '#7f7f7f': '#555555', '#808080': '#8c8c8c',	# guide centre, bumper shading, LB/RB/LT/RT
	'#000000': PAD_EDGE,							# outlines
}
CONTROLLER_LAYOUT = [	# the control (0..1 of the controller), where the label goes, its top in pixels, the string
	((0.229, 0.080), 'L', 60, 'Alt fire'),						# LT: +attack2
	((0.237, 0.219), 'L', 95, 'Previous weapon'),					# LB: invprev; invselect
	((0.195, 0.579), 'L', 177, 'Move\nClick: crouch'),				# left stick: toggle_duck
