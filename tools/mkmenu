def read_tokens(path):			# Valve's files are UTF-8 or UTF-16, ours are UTF-8
	try:
		raw = open(path, 'rb').read()
	except OSError:
		return {}
	text = raw.decode('utf-16-le') if raw[:2] == b'\xff\xfe' else raw.decode('utf-8-sig', 'replace')
	unescape = lambda t: t.replace('\\\\', '\x00').replace('\\n', '\n').replace('\x00', '\\')	# as mainui reads them
	return { unescape(k): unescape(v) for k, v in re.findall(r'^\s*"([^"]+)"\s+"([^"]*)"', text, re.M) }

def valve_tokens(language):
	d = os.path.join(data, 'valve' if language == 'english' else 'valve_' + language, 'resource')
	t = read_tokens(os.path.join(d, f'gameui_{language}.txt'))
	t.update(read_tokens(os.path.join(d, f'valve_{language}.txt')))
	return t

def write_banners(dir, texts):
	os.makedirs(dir, exist_ok=True)
	one = min(size, fit_size(max(texts.values(), key=len)))	# one size per language: its longest heading, as wide
								# as Valve's, and never larger than the English set
	for name, text in texts.items():
		write_tga(banner(text, one), os.path.join(dir, name + '.tga'))
	print(f'  {dir.replace(run, "")}: {len(texts)} banners at {one:.1f} px')

def controller_diagram(say):
	'''The Controller page's picture for one language: the drawing in black, a leader line from each control to its
	label, the labels. Left labels end at the controller's left, right ones start at its right, the two
	centre buttons label upwards.'''
	svg = open(os.path.join(art, '360_controller.svg')).read()
	for white, black in PAD_PALETTE.items():
		svg = re.sub(re.escape(white), black, svg, flags=re.I)
	svg = svg.replace('style="overflow:visible"', f'style="overflow:visible;fill:{PAD_EDGE}"', 1)	# the unfilled shapes
	png = subprocess.run([CAIROSVG, '-', '-f', 'png', '-o', '-', '--output-width', str(PAD_W), '--output-height', str(PAD_H)],
		input=svg.encode(), check=True, capture_output=True).stdout
	im = Image.new('RGBA', (DIAGRAM_W, DIAGRAM_H), (0, 0, 0, 0))
	im.alpha_composite(Image.open(io.BytesIO(png)).convert('RGBA'), (PAD_X, PAD_Y))
	lines = Image.new('L', (DIAGRAM_W * S, DIAGRAM_H * S))		# drawn 4x oversized for smooth edges
	d = ImageDraw.Draw(lines)
	font = ImageFont.truetype(io.BytesIO(label_font), LABEL_SIZE)
	labels = []
	for (fx, fy), side, top, key in CONTROLLER_LAYOUT:
		text = say(key).split('\n')
		cx, cy = PAD_X + fx * PAD_W, PAD_Y + fy * PAD_H
		mid = top + len(text) * LABEL_LINE / 2
		if side == 'L':
			edge, end = PAD_X - LABEL_GAP, (PAD_X - LINE_GAP, mid)
		elif side == 'R':
			edge, end = PAD_X + PAD_W + LABEL_GAP, (PAD_X + PAD_W + LINE_GAP, mid)
		elif side == 'TL':
			edge, end = cx - 20, (cx - 18, top + len(text) * LABEL_LINE)
		else:
			edge, end = cx + 20, (cx + 18, top + len(text) * LABEL_LINE)
		d.line([(cx * S, cy * S), (end[0] * S, end[1] * S)], fill=255, width=2 * S)
		d.ellipse([(cx - 3) * S, (cy - 3) * S, (cx + 3) * S, (cy + 3) * S], fill=255)
		labels.append((edge, top, text, side in ('L', 'TL')))
	mask = lines.resize((DIAGRAM_W, DIAGRAM_H), Image.LANCZOS)
	im.alpha_composite(Image.merge('RGBA', [Image.new('L', mask.size, c) for c in WON_ORANGE] + [mask]))
	d = ImageDraw.Draw(im)
	for edge, top, text, right_aligned in labels:
		for i, line in enumerate(text):
			x = edge - font.getlength(line) if right_aligned else edge
			if x < 0 or x + font.getlength(line) > DIAGRAM_W:
				print(f'  controller picture: "{line}" runs off the edge, shorten it')
			d.text((x, top + i * LABEL_LINE), line, font=font, fill=WON_ORANGE + (255,))
	return im

def install(language, dir, ours):
	tokens = valve_tokens(language)
	tokens.update(ours)				# ours wins: it is what the data leaves untranslated
	english = valve_tokens('english')
	def say(key):					# a token, or the English text that is its own key
		return tokens.get(key) or english.get(key) or key
	write_banners(os.path.join(dir, 'gfx', 'shell'), { n: ours.get('Banner_' + n) or say(BANNERS[n]) for n in BANNERS })
	write_buttons(os.path.join(dir, 'gfx', 'shell', 'btns_main.bmp'),
		{ i: say(key) for i, key in BUTTONS.items() }, valve_buttons)
	write_tga(controller_diagram(say), os.path.join(dir, 'gfx', 'shell', 'controller.tga'))

