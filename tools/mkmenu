	4: 'GameUI_LoadGame', 5: 'Save\\Load Game', 7: 'GameUI_GameMenu_Quit',
	9: 'GameUI_Easy', 10: 'GameUI_Medium', 11: 'GameUI_Hard', 12: 'GameUI_SaveGame', 13: 'GameUI_LoadGame',
	14: 'GameUI_Cancel', 15: 'Game options', 16: 'GameUI_Video', 17: 'GameUI_Audio', 18: 'Controller',
	19: 'Done', 21: 'GameUI_UseDefaults', 22: 'GameUI_OK', 23: 'Video options', 24: 'Video modes',
	25: 'Adv. Controls', 27: 'Delete', 52: 'Update', 54: 'GameUI_GameMenu_Disconnect', 55: 'GameUI_Console',
