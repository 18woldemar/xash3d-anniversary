#!/usr/bin/env bash
# A release archive for Linux and the Steam Deck: everything but the game, which the launcher finds in Steam.
# A release is built inside Valve's Steam Runtime 3 SDK, so the binaries ask for no newer glibc than the Deck has.
# The menu art and the captions come from the run tree: run tools/mkmenu and tools/mksubs first.
# Usage: package <version> [output directory]    (default <workspace>/dist)
# SNIPER_ROOT is the unpacked SDK sysroot (default <workspace>/build/sniper/root), from
# repo.steampowered.com/steamrt3/images/latest-public-beta/, the file ...Sdk-amd64,i386-sniper-sysroot.tar.gz
# PACKAGE_HOST=1 packs this machine's own build instead: for checking the archive, it will not run on a Deck.
# PACKAGE_WIN=1 makes the Windows archive instead: MSVC builds it on the Windows VM BUILD_VM (default win10vm, reached
# over ssh, set up once with tools/win/deps.ps1; see tools/win/build.bat).
set -euo pipefail
[ $# -ge 1 ] || { sed -n '2,8p' "$0" >&2; exit 2; }
version=$1
tools=$(dirname "$(readlink -f "$0")")
top=$(readlink -f "$tools/../..")
out=${2:-$top/dist}
root=${SNIPER_ROOT:-$top/build/sniper/root}
run=$top/run/halflife
work=$top/build/package
name=xash3d-anniversary-$version
dst=$work/$name

for f in valve/gfx/shell/head_video.tga valve/gfx/shell/pad_y.tga valve/resource/mainui_russian.txt valve/subtitles_english.txt; do
	[ -f "$run/$f" ] || { echo "package: no $f in the run tree: run tools/mkmenu and tools/mksubs" >&2; exit 1; }
done

rm -rf "$work"
mkdir -p "$work" "$dst" "$out"

if [ -n "${PACKAGE_WIN:-}" ]; then
	vm=${BUILD_VM:-win10vm}
	# the VM has no git: an empty .git and the answers waf wants, for tools/win/git.bat; submodules with local
	# changes of their own (the unused gl4es and maintui here) do not make the build dirty
	for tree in xash3d-anniversary hlsdk-anniversary; do
		mkdir -p "$work/git/$tree/.git"
		printf 'GIT_DESCRIBE=%s\r\nGIT_BRANCH=%s\r\nGIT_DATE=%s\r\n' "$(git -C "$top/$tree" describe --always)$(git -C "$top/$tree" diff --quiet --ignore-submodules HEAD || echo -dirty)" \
			"$(git -C "$top/$tree" rev-parse --abbrev-ref HEAD)" "$(git -C "$top/$tree" log -1 --format=%ci)" > "$work/git/$tree/.gitinfo"
	done
	tar -C "$top" -cf "$work/src.tar" --exclude=.git --exclude=build --exclude='.waf*' --exclude='.lock-waf*' xash3d-anniversary hlsdk-anniversary
	tar -C "$work/git" -rf "$work/src.tar" xash3d-anniversary hlsdk-anniversary
	gzip -c "$work/src.tar" > "$work/src.tgz"
	for f in build.bat git.bat; do sed 's/$/\r/' "$tools/win/$f" > "$work/$f"; done
	scp -q "$work/src.tgz" "$vm:C:/work/anniversary/src.tgz"
	scp -q "$work/build.bat" "$work/git.bat" "$vm:C:/work/anniversary/tools/"
	ssh "$vm" 'C:\work\anniversary\tools\build.bat > C:\work\anniversary\build.log 2>&1 & rem' || true
	scp -q "$vm:C:/work/anniversary/build.log" "$work/build.log"
	grep -q 'BUILD OK' "$work/build.log" || { grep -aE 'error|Error' "$work/build.log" | tail -20; echo "package: the VM build failed, $work/build.log" >&2; exit 1; }
	scp -q -r "$vm:C:/work/anniversary/out" "$work/prefix"
	rsync -a --exclude='*.pdb' --exclude='SDL2-LICENSE.txt' "$work/prefix/" "$dst/"
elif [ -n "${PACKAGE_HOST:-}" ]; then
	cp -a "$top/build/prefix/." "$dst/"
else
	[ -x "$root/usr/bin/gcc" ] || { echo "package: no SDK at $root" >&2; exit 1; }
	mkdir -p "$work/src"
	for tree in xash3d-anniversary hlsdk-anniversary; do
		rsync -a --exclude='.lock-waf*' --exclude='.waf-*' "$top/$tree" "$work/src/"
	done

	cat > "$work/build.sh" <<'EOS'
set -e
for tree in xash3d-anniversary hlsdk-anniversary; do
	cd /w/build/package/src/$tree
	./waf configure -T release -8 -o /w/build/package/out/$tree --prefix=/ > /w/build/package/$tree.log 2>&1
	./waf build install --destdir=/w/build/package/prefix >> /w/build/package/$tree.log 2>&1
done
EOS
	bwrap --unshare-user --uid 0 --gid 0 --bind "$root" / --dev /dev --proc /proc --tmpfs /tmp --bind "$top" /w --chdir /w \
		--setenv PATH /usr/bin:/bin --setenv HOME /tmp sh /w/build/package/build.sh ||
		{ tail -20 "$work"/*.log; exit 1; }
	cp -a "$work/prefix/." "$dst/"
fi

# Windows finds the game itself (filesystem_engine.c FS_FindSteamInstall), Linux through the launcher
[ -n "${PACKAGE_WIN:-}" ] || cp "$tools/launcher.sh" "$dst/xash3d-anniversary"
rsync -a --include='/valve/' --include='/valve_*/' --include='/valve*/gfx/' --include='/valve*/gfx/shell/***' \
	--include='/valve/resource/' --include='/valve/resource/mainui_*.txt' --include='/valve*/subtitles_*.txt' \
	--exclude='*' --prune-empty-dirs "$run/" "$dst/"

mkdir -p "$dst/licenses"
cp /usr/share/common-licenses/GPL-3 "$dst/licenses/GPL-3" # the engine and the menu: GPL v3 or later
for f in LICENSE LICENSE.md license; do
	if [ -f "$top/hlsdk-anniversary/$f" ]; then cp "$top/hlsdk-anniversary/$f" "$dst/licenses/hlsdk-$f"; fi
done
cp "$tools/menu/CREDITS.md" "$dst/licenses/menu-art-CREDITS.md"
if [ -n "${PACKAGE_WIN:-}" ]; then cp "$work/prefix/SDL2-LICENSE.txt" "$dst/licenses/SDL2-LICENSE.txt"; fi
cat > "$dst/licenses/Gamepad-Asset-Pack-LICENSE" <<'EOT'
The pad legend's icons are rendered from AL2009man/Gamepad-Asset-Pack.

MIT License

Copyright (c) 2024 Al. Lopez

Permission is hereby granted, free of charge, to any person obtaining a copy
of this software and associated documentation files (the "Software"), to deal
in the Software without restriction, including without limitation the rights
to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
copies of the Software, and to permit persons to whom the Software is
furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all
copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
SOFTWARE.
EOT
if [ -n "${PACKAGE_WIN:-}" ]; then
	cat > "$dst/README.txt" <<EOT
xash3d-anniversary $version: Half-Life for Windows, with a menu made for a pad, speech subtitles and three render
styles (Original, Software, Enhanced) that switch on the fly.

You need Half-Life in Steam: nothing of the game is in this archive.
Unpack it anywhere you can write to and run xash3d.exe; it finds Half-Life in your Steam libraries. If it does not,
start it with -rodir "<the Half-Life folder>". For the pad menu add -gamepadui, or start it from Steam Big Picture
as a non-Steam game. Saves and settings stay in valve\ next to xash3d.exe.

Source: https://github.com/18woldemar/xash3d-anniversary
Licences and where the art comes from are in licenses\. The speech captions are Fograin's Half-Life Subtitles MOD.
EOT
	tr -d '\r' < "$dst/README.txt" | sed 's/$/\r/' > "$work/README.txt" && mv "$work/README.txt" "$dst/README.txt"
	rm -f "$out/$name-windows-amd64.zip"
	(cd "$work" && zip -qr9 "$out/$name-windows-amd64.zip" "$name")
	du -h "$out/$name-windows-amd64.zip"
	exit 0
fi

cat > "$dst/README.txt" <<EOT
xash3d-anniversary $version: Half-Life for Linux and the Steam Deck, with a menu made for a pad, speech subtitles
and three render styles (Original, Software, Enhanced) that switch on the fly.

You need Half-Life in Steam: nothing of the game is in this archive.
Unpack it anywhere you can write to and run ./xash3d-anniversary. On the Deck, add that file to Steam as a
non-Steam game. Add -gamepadui on a desktop for the pad menu; on the Deck it is the default. SDL2 comes from the system.

Source: https://github.com/18woldemar/xash3d-anniversary
Licences and where the art comes from are in licenses/. The speech captions are Fograin's Half-Life Subtitles MOD.
EOT

tar -C "$work" -czf "$out/$name-linux-amd64.tar.gz" "$name"
du -h "$out/$name-linux-amd64.tar.gz"
